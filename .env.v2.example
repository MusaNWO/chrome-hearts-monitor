# ── Chrome Hearts Monitor V2 (NEW bot — does not affect the old bot) ──

# From @BotFather after /newbot
TELEGRAM_BOT_TOKEN=paste_v2_token_here

# Your Telegram user id(s), comma-separated
# Get id from @userinfobot, or after messaging the new bot
TELEGRAM_CHAT_ID=paste_chat_id_here

# Optional: send booking confirmations / manage links elsewhere
# (alerts + BOOK button stay on TELEGRAM_* above)
# TELEGRAM_CONFIRM_BOT_TOKEN=paste_confirm_bot_token_here
# TELEGRAM_CONFIRM_CHAT_ID=paste_confirm_chat_id_here

# Locations to watch
LOCATION_IDS=chromeheartsmiami,chromehearts

# Booking flags
AUTO_BOOK_ENABLED=1
# Only these locations auto-book (comma-separated). Others = BOOK button only.
AUTO_BOOK_LOCATION_IDS=chromeheartsmiami
DRY_RUN=0
HEADED=1

# CapSolver (fallback when browser reCAPTCHA score is low)
# CAPSOLVER_API_KEY=CAP-xxxx

# ── IP rotation (recommended on Railway for reCAPTCHA) ──
# Use a US residential / ISP proxy. Sticky session preferred.
# Same proxy is used for browser + CapSolver so token IP matches submit IP.
#
# WAITWHILE_PROXY=http://USERNAME:PASSWORD@proxy-host:port
# Or a pool (round-robin):
# WAITWHILE_PROXIES=http://user:pass@host:port,http://user2:pass2@host:port
#
# Rotate sticky session id on each captcha retry (new egress IP):
# WAITWHILE_PROXY_ROTATE=1
# WAITWHILE_PROXY_COUNTRY=us
#
# Username template example (IPRoyal / similar):
# WAITWHILE_PROXY=http://user_{session}_country-{country}:pass@gate.iproyal.com:12321
# CAPSOLVER_USE_PROXY=1
# CAPSOLVER_M1=1
