# ── Chrome Hearts Monitor V2 (NEW bot — does not affect the old bot) ──

# From @BotFather after /newbot
TELEGRAM_BOT_TOKEN=paste_v2_token_here

# Your Telegram user id(s), comma-separated
# Get id from @userinfobot, or after messaging the new bot
TELEGRAM_CHAT_ID=paste_chat_id_here

# Optional: send booking confirmations / manage links elsewhere
# (alerts + BOOK button stay on TELEGRAM_* above)
# TELEGRAM_CONFIRM_BOT_TOKEN=paste_confirm_bot_token_here
# TELEGRAM_CONFIRM_CHAT_ID=paste_confirm_chat_id_here

# Locations to watch
LOCATION_IDS=chromeheartsmiami,chromehearts

# Booking flags
AUTO_BOOK_ENABLED=1
# Only these locations auto-book (comma-separated). Others = BOOK button only.
AUTO_BOOK_LOCATION_IDS=chromeheartsmiami
DRY_RUN=0
HEADED=1
